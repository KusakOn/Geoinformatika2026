def uprav_body(X,Y,Z, kolik):
    X_new = []
    Y_new = []
    Z_new = []

    for pozice in range (kolik):
        X_new.append(X[pozice])
        Y_new.append(Y[pozice])
        Z_new.append(Z[pozice])

    return X_new, Y_new, Z_new


