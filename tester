def vytvor_graf(X, Y, nazev, filename="graf.svg"):
    x_interp = np.linspace(0, max(X), 300)
    y_interp = np.interp(x_interp, [0] + list(X), [0] + list(Y))

    plt.figure(figsize=(8, 5))
    plt.plot(x_interp, y_interp, linewidth=2)
    plt.scatter(X, Y, color="red", zorder=3)

    plt.xlabel("Velikost datasetu")
    plt.ylabel("Sekundy")

    plt.title(nazev)

    plt.xlim(left=0)
    plt.ylim(bottom=0)

    plt.grid(True, linestyle="--", alpha=0.5)
    plt.tight_layout()

    plt.savefig(filename, format="svg", bbox_inches="tight")
    plt.show()
    plt.close()





